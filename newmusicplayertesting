-- ============================================================
-- AUTOPLAY CHECK
-- ============================================================

local function checkTapeEnd()
    if not playing then
        return
    end

    if tape.isPlaying() then
        return
    end

    -- If manually stopped, the UI event handler changes
    -- playing to false before this matters.
    --
    -- Otherwise the tape has reached its end.

    if autoplay and #queue > 0 then

        playing = false
        playingVideo = false

        local nextTrack =
            getNextTrack()

        if nextTrack then
            playResult(nextTrack)
        end

    else
        playing = false
        playingVideo = false
    end
end


-- ============================================================
-- UI LOOP
-- ============================================================

local function uiLoop()

    while not restart_requested do

        redrawScreen()

        local event,
            p1,
            p2,
            p3 =
            os.pullEvent()

        --------------------------------------------------------
        -- MOUSE
        --------------------------------------------------------

        if event == "mouse_click" then

            local button = p1
            local x = p2
            local y = p3

            ----------------------------------------------------
            -- SEARCH
            ----------------------------------------------------

            if active_tab == 1 then

                -- Search box.
                if y >= 4 and y <= 4 then

                    doSearchInput()

                -- Search result area.
                elseif y >= 6
                    and y <= height - 2
                then

                    -- + button.
                    if x >= width - 2 then

                        addSearchResultToPlaylist(y)

                    else

                        -- IMPORTANT:
                        -- Left click goes directly into
                        -- playResult(), which downloads BOTH
                        -- audio and video for this result.
                        handleSearchClick(
                            x,
                            y,
                            button
                        )
                    end
                end

            ----------------------------------------------------
            -- PLAYLIST
            ----------------------------------------------------

            elseif active_tab == 2 then

                handlePlaylistClick(
                    x,
                    y
                )

            ----------------------------------------------------
            -- QUEUE
            ----------------------------------------------------

            elseif active_tab == 3 then

                handleQueueClick(
                    x,
                    y
                )
            end

        --------------------------------------------------------
        -- KEYBOARD
        --------------------------------------------------------

        elseif event == "key" then

            local key = p1

            ----------------------------------------------------
            -- TAB NAVIGATION
            ----------------------------------------------------

            if key == keys.left then

                active_tab =
                    active_tab - 1

                if active_tab < 1 then
                    active_tab = #tabs
                end

            elseif key == keys.right then

                active_tab =
                    active_tab + 1

                if active_tab > #tabs then
                    active_tab = 1
                end

            ----------------------------------------------------
            -- SEARCH
            ----------------------------------------------------

            elseif key == keys.enter
                and active_tab == 1
            then

                doSearchInput()

            ----------------------------------------------------
            -- SCROLL
            ----------------------------------------------------

            elseif key == keys.up then

                if active_tab == 1 then

                    search_scroll =
                        math.max(
                            1,
                            search_scroll - 1
                        )

                elseif active_tab == 2 then

                    playlist_scroll =
                        math.max(
                            1,
                            playlist_scroll - 1
                        )

                elseif active_tab == 3 then

                    queue_scroll =
                        math.max(
                            1,
                            queue_scroll - 1
                        )
                end

            elseif key == keys.down then

                if active_tab == 1 then

                    search_scroll =
                        math.min(
                            math.max(
                                1,
                                #search_results
                            ),
                            search_scroll + 1
                        )

                elseif active_tab == 2 then

                    playlist_scroll =
                        math.min(
                            math.max(
                                1,
                                #playlist
                            ),
                            playlist_scroll + 1
                        )

                elseif active_tab == 3 then

                    queue_scroll =
                        math.min(
                            math.max(
                                1,
                                #queue
                            ),
                            queue_scroll + 1
                        )
                end

            ----------------------------------------------------
            -- SPACE = PLAY / PAUSE
            ----------------------------------------------------

            elseif key == keys.space then

                if tape.isPlaying() then

                    tape.stop()
                    playing = false
                    playingVideo = false

                elseif current_track then

                    tape.play()
                    playing = true

                    if currentVideo then
                        playingVideo = true
                        lastVideoFrame = -1
                    end
                end

            ----------------------------------------------------
            -- S = STOP
            ----------------------------------------------------

            elseif key == keys.s then

                tape.stop()

                playing = false
                playingVideo = false

                clearVideo()

            ----------------------------------------------------
            -- N = NEXT
            ----------------------------------------------------

            elseif key == keys.n then

                tape.stop()

                playing = false
                playingVideo = false

                playNextTrack()

            ----------------------------------------------------
            -- A = AUTOPLAY
            ----------------------------------------------------

            elseif key == keys.a then

                autoplay = not autoplay

            ----------------------------------------------------
            -- W = WIPE TAPE
            ----------------------------------------------------

            elseif key == keys.w then

                tape.stop()

                playing = false
                playingVideo = false

                clearVideo()

                local size =
                    tape.getSize()

                local chunkSize = 4096

                rewindTape()

                local remaining = size

                while remaining > 0 do

                    local amount =
                        math.min(
                            remaining,
                            chunkSize
                        )

                    tape.write(
                        string.rep(
                            "\0",
                            amount
                        )
                    )

                    remaining =
                        remaining - amount

                    redrawScreen()
                end

                rewindTape()

            ----------------------------------------------------
            -- U = UPDATE
            ----------------------------------------------------

            elseif key == keys.u then

                restart_requested = true
            end

        --------------------------------------------------------
        -- MOUSE WHEEL
        --------------------------------------------------------

        elseif event == "mouse_scroll" then

            local direction = p1

            if active_tab == 1 then

                search_scroll =
                    clamp(
                        search_scroll + direction,
                        1,
                        math.max(
                            1,
                            #search_results
                        )
                    )

            elseif active_tab == 2 then

                playlist_scroll =
                    clamp(
                        playlist_scroll + direction,
                        1,
                        math.max(
                            1,
                            #playlist
                        )
                    )

            elseif active_tab == 3 then

                queue_scroll =
                    clamp(
                        queue_scroll + direction,
                        1,
                        math.max(
                            1,
                            #queue
                        )
                    )
            end
        end

        --------------------------------------------------------
        -- AUTOPLAY
        --------------------------------------------------------

        if
            playing
            and not tape.isPlaying()
        then
            checkTapeEnd()
        end
    end
end


-- ============================================================
-- TAPE MONITOR LOOP
-- ============================================================

local function tapeLoop()
    while true do

        if playing then

            if tape.isPlaying() then
                drawTapeProgress()
            end

        end

        sleep(0.1)
    end
end


-- ============================================================
-- PLAYER UPDATE
-- ============================================================

local function updatePlayer()
    while not restart_requested do
        sleep(1)
    end

    if not restart_requested then
        return
    end

    tape.stop()

    clearVideo()

    local url = player_update_url

    local response, err =
        http.get(url)

    if not response then
        term.clear()
        term.setCursorPos(1, 1)
        term.setTextColor(colors.red)
        print(
            "Update failed: "
            .. tostring(err)
        )

        sleep(3)
        return
    end

    local newCode =
        response.readAll()

    response.close()

    if not newCode or #newCode < 100 then
        term.clear()
        term.setCursorPos(1, 1)
        term.setTextColor(colors.red)
        print("Downloaded player is invalid.")

        sleep(3)
        return
    end

    local temp =
        "musica.lua.new"

    local file =
        fs.open(
            temp,
            "w"
        )

    file.write(newCode)
    file.close()

    if fs.exists("musica.lua") then
        fs.delete("musica.lua")
    end

    fs.move(
        temp,
        "musica.lua"
    )

    term.clear()
    term.setCursorPos(1, 1)

    term.setTextColor(colors.lime)
    print("Player updated.")
    print("Restarting...")

    sleep(2)

    shell.run(
        "musica.lua"
    )

    restart_requested = true
end


-- ============================================================
-- START
-- ============================================================

redrawScreen()

parallel.waitForAny(
    uiLoop,
    videoLoop,
    tapeLoop,
    updatePlayer
)

term.setBackgroundColor(colors.black)
term.setTextColor(colors.white)
term.clear()
term.setCursorPos(1, 1)
