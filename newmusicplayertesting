-- ============================================================
-- UTILITY
-- ============================================================

local function safeUrlEncode(value)
    if not value then
        return ""
    end

    return textutils.urlEncode(tostring(value))
end


local function getTrackURL(track)
    if type(track) ~= "table" then
        return nil
    end

    return track.url or track.webpage_url or track.id
end


local function getTrackName(track)
    if not track then
        return "Unknown"
    end

    return track.title or track.name or "Unknown"
end


local function getTrackArtist(track)
    if not track then
        return ""
    end

    return track.artist
        or track.uploader
        or track.channel
        or ""
end


local function clamp(value, minimum, maximum)
    if value < minimum then
        return minimum
    end

    if value > maximum then
        return maximum
    end

    return value
end


