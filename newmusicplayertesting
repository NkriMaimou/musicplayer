local function filterPromo(results)
    local output = {}

    if type(results) ~= "table" then
        return output
    end

    for _, result in ipairs(results) do
        if type(result) == "table" then
            local title = tostring(
                result.title
                or result.name
                or ""
            ):lower()

            if not title:find("sponsored", 1, true)
                and not title:find("promoted", 1, true) then

                table.insert(output, result)
            end
        end
    end

    return output
end


local function performSearch(query)
    searching = true
    search_results = {}
    search_scroll = 1

    local url =
        api_base_url
        .. "?query="
        .. safeUrlEncode(query)

    http.request(url)

    while searching do
        local event, a, b = os.pullEvent()

        if event == "http_success" and a == url then
            local response = a
            local handle = b

            local body = handle.readAll()
            handle.close()

            local ok, data =
                pcall(textutils.unserialiseJSON, body)

            if ok and type(data) == "table" then
                search_results = filterPromo(
                    data.results or data
                )
            end

            searching = false

        elseif event == "http_failure" and a == url then
            searching = false

            term.setCursorPos(1, 5)
            term.setTextColor(colors.red)
            term.write("Search failed.")
            sleep(1)
        end
    end
end


local function drawSearch()
    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.white)

    term.setCursorPos(1, 4)
    term.clearLine()

    term.setTextColor(colors.gray)
    term.write("Search: ")

    term.setTextColor(colors.white)
    term.write(search_text)

    local startY = 6
    local maxRows = height - 7

    if #search_results == 0 then
        term.setCursorPos(1, startY)

        if searching then
            term.setTextColor(colors.yellow)
            term.write("Searching...")
        else
            term.setTextColor(colors.gray)
            term.write("Type a search and press Enter.")
        end

        return
    end

    for row = 0, maxRows - 1 do
        local index = search_scroll + row

        if index > #search_results then
            break
        end

        local result = search_results[index]

        local name = getTrackName(result)
        local artist = getTrackArtist(result)

        local line =
            tostring(name)
            .. " - "
            .. tostring(artist)

        local available =
            width - 4

        if #line > available then
            line = line:sub(1, available - 3) .. "..."
        end

        term.setCursorPos(1, startY + row)
        term.setTextColor(colors.white)

        term.write(
            string.format(
                "%2d %s",
                index,
                line
            )
        )

        term.setCursorPos(width - 1, startY + row)
        term.setTextColor(colors.lime)
        term.write("+")
    end
end


