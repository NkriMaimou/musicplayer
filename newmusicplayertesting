-- ============================================================
-- PLAYLIST CONTROLS
-- ============================================================

local function handlePlaylistClick(x, y)
    local startY = 6

    if y < startY then
        return
    end

    local index =
        playlist_scroll
        + (y - startY)

    if index < 1
        or index > #playlist then
        return
    end

    if x >= width - 8
        and x < width - 6
    then
        -- Move up.

        if index > 1 then
            playlist[index],
            playlist[index - 1] =
                playlist[index - 1],
                playlist[index]

            playlist_scroll =
                clamp(
                    playlist_scroll,
                    1,
                    math.max(
                        1,
                        #playlist
                    )
                )
        end

    elseif x >= width - 6
        and x < width - 4
    then
        -- Move down.

        if index < #playlist then
            playlist[index],
            playlist[index + 1] =
                playlist[index + 1],
                playlist[index]

            playlist_scroll =
                clamp(
                    playlist_scroll,
                    1,
                    math.max(
                        1,
                        #playlist
                    )
                )
        end

    elseif x >= width - 3 then
        -- Remove.

        table.remove(
            playlist,
            index
        )

        playlist_scroll =
            clamp(
                playlist_scroll,
                1,
                math.max(
                    1,
                    #playlist
                )
            )
    end
end


-- ============================================================
-- QUEUE CONTROLS
-- ============================================================

local function handleQueueClick(x, y)
    local startY = 6

    -- Toggle autoplay by clicking title area.
    if y == 4 then
        autoplay = not autoplay
        return
    end

    if y < startY then
        return
    end

    local index =
        queue_scroll
        + (y - startY)

    if index < 1
        or index > #queue then
        return
    end

    if x >= width - 8
        and x < width - 6
    then
        if index > 1 then
            queue[index],
            queue[index - 1] =
                queue[index - 1],
                queue[index]
        end

    elseif x >= width - 6
        and x < width - 4
    then
        if index < #queue then
            queue[index],
            queue[index + 1] =
                queue[index + 1],
                queue[index]
        end

    elseif x >= width - 3 then
        table.remove(
            queue,
            index
        )

        queue_scroll =
            clamp(
                queue_scroll,
                1,
                math.max(
                    1,
                    #queue
                )
            )
    end
end


