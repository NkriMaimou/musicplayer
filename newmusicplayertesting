local function drawTapeProgress()
    local y = height

    term.setBackgroundColor(colors.black)
    term.setTextColor(colors.gray)

    term.setCursorPos(1, y)
    term.clearLine()

    local size = tape.getSize() or 0
    local pos = tape.getPosition() or 0

    local percent = 0

    if size > 0 then
        percent = clamp(pos / size, 0, 1)
    end

    local barWidth = math.max(10, width - 12)
    local filled = math.floor(barWidth * percent)

    term.setCursorPos(1, y)
    term.write("[")

    if filled > 0 then
        term.write(string.rep("=", filled))
    end

    if filled < barWidth then
        term.write(string.rep("-", barWidth - filled))
    end

    term.write("]")

    term.setCursorPos(width - 8, y)
    term.write(string.format("%3d%%", math.floor(percent * 100)))
end


